# Supabase — get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API — for AI insights (Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# App URL — used for OAuth redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Alpha Vantage for US stocks (free tier: 25 req/day)
ALPHA_VANTAGE_API_KEY=your-key-here

# Optional: Open Exchange Rates for FX (free tier: 1000 req/mo)
OPEN_EXCHANGE_RATES_APP_ID=your-app-id
